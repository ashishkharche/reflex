#!/bin/sh
# Checks every commit about to be pushed.
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
while read -r _ local _ remote; do
  [ "$local" = "$zero" ] && continue
  if [ "$remote" != "$zero" ] && git cat-file -e "$remote^{commit}" 2>/dev/null; then
    "$root/scripts/check_authors.sh" "$remote..$local" || exit 1
  else
    "$root/scripts/check_authors.sh" "$local" || exit 1
  fi
done
