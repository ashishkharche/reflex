{
 "version": 1,
 "about": "Shared strict decoder conformance. Swift and Kotlin kit tests both run every case. A case sends one line to a fresh probe session after hello (unless handshake is false). reject is [code, path]; accept is the decoded input the probe records; response is a type-strict partial match on the reply. matcher cases call Expect.matches(actual, expected). A stream case feeds the hex bytes to LineFramer, answers each line with handle(bytes:), then requires the exact reply bytes in wire, where @node stands for the probe node before the stream. Keys and strings compare by exact UTF-16 code units.",
 "schemas": {"start": {"type": "object", "properties": {"seconds": {"type": "integer", "format": "int64"}, "label": {"type": "string"}, "fanOn": {"type": "boolean"}, "meta": {"type": "object", "properties": {"tag": {"type": "string"}, "level": {"type": "integer", "format": "int64"}}, "required": ["tag"], "additionalProperties": false}, "laps": {"type": "array", "items": {"type": "integer", "format": "int64"}}, "rows": {"type": "array", "items": {"type": "object", "properties": {"n": {"type": "integer", "format": "int64"}}, "required": ["n"], "additionalProperties": false}}}, "required": ["seconds"], "additionalProperties": false}, "bounded": {"type": "object", "properties": {"count": {"type": "integer", "format": "int64", "minimum": 0, "maximum": 100}}, "required": ["count"], "additionalProperties": false}, "accent": {"type": "object", "properties": {"\u00e9": {"type": "string"}}, "required": [], "additionalProperties": false}},
 "probe": {"name": "Probe", "actions": {"Start": "start", "Skip": null, "Bounded": "bounded", "Kelvin": "accent"}},
 "cases": [
  {"id": "F-01-string-seconds", "finding": "F-01", "action": "Start", "input": "{\"seconds\":\"90\"}", "reject": ["field.type", "$.input.seconds"]},
